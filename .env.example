# Supply Chain AI Value Navigator
# Copy this file to `.env` and fill in the values you want to use.
# All variables are optional — without them the app runs in manual mode.

# OpenAI key. When unset, /api/analyze returns a manual-mode response and
# the UI runs entirely on user-edited inputs.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Chat model used for company inference. Any JSON-mode capable model works.
# Defaults to gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini

# Override path to the demo-mapping workbook. Leave blank to use
# `./supply_chain_demo_mapping.xlsx` in the project folder.
EXCEL_PATH=

# Server port.
PORT=8000
